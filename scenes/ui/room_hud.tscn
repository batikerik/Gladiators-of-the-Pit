[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/combat_hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_bg"]
bg_color = Color(0.12, 0.1, 0.15, 0.8)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_player_hp"]
bg_color = Color(0.2, 0.75, 0.35, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_enemy_hp"]
bg_color = Color(0.85, 0.25, 0.25, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")
show_end_messages = false
restart_reloads_scene = false

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 90.0
grow_horizontal = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 40

[node name="VBoxTop" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2

[node name="HBoxBars" type="HBoxContainer" parent="MarginContainer/VBoxTop"]
layout_mode = 2
theme_override_constants/separation = 60

[node name="PlayerBox" type="VBoxContainer" parent="MarginContainer/VBoxTop/HBoxBars"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PlayerName" type="Label" parent="MarginContainer/VBoxTop/HBoxBars/PlayerBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18

[node name="PlayerHP" type="ProgressBar" parent="MarginContainer/VBoxTop/HBoxBars/PlayerBox"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_player_hp")
value = 100.0
show_percentage = false

[node name="EnemyBox" type="VBoxContainer" parent="MarginContainer/VBoxTop/HBoxBars"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EnemyName" type="Label" parent="MarginContainer/VBoxTop/HBoxBars/EnemyBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
horizontal_alignment = 2

[node name="EnemyHP" type="ProgressBar" parent="MarginContainer/VBoxTop/HBoxBars/EnemyBox"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_enemy_hp")
value = 100.0
fill_mode = 1
show_percentage = false

[node name="CenterContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="MessageLabel" type="Label" parent="CenterContainer"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0.05, 0.03, 0.05, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="MarginContainerBottom" type="MarginContainer" parent="."]
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -50.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_constants/margin_bottom = 14

[node name="RestartHint" type="Label" parent="MarginContainerBottom"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.75, 0.7, 0.75)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
text = "[A/D] Hop | [LMB] Slash | [RMB] Thrust | [S] Guard | [E] Take / Go | [Q] Eat | [1-3] Weapon | [Tab] Inventory | [Esc] Pause"
